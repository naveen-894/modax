# Existing contact form integration (Resend)
RESEND_API_KEY=re_...

# Contact info shown on the site (footer, contact page, CTA, JSON-LD)
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_PHONE_DISPLAY=
CONTACT_WHATSAPP=
# Where contact form submissions are delivered (Resend "to" address)
CONTACT_FORM_RECIPIENT=

# AI Chatbot — proxied through app/api/chatbot/* to the FastAPI backend in the
# ai_resume_match repo. Never exposed to the browser: only used server-side by
# the Next.js route handlers.
CHATBOT_BACKEND_URL=http://localhost:8000
# Must match CHATBOT_INTERNAL_API_KEY in the backend's .env (see
# ai_resume_match/.env.example). Leave both unset for local development.
CHATBOT_INTERNAL_API_KEY=
